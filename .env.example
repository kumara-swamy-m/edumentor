# ---- Common ----
SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=yourpassword

# ---- Auth / JWT (shared by auth-service and api-gateway; min 32 bytes) ----
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION_MS=3600000

# ---- Optional bootstrap admin (created at startup if both are set) ----
ADMIN_EMAIL=admin@edumentor.local
ADMIN_PASSWORD=ChangeMe123

# ---- Service discovery ----
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka
AUTH_SERVICE_URL=http://localhost:8081
MENTOR_SERVICE_URL=http://localhost:8082
        HOLD_DURATION=PT10M
BOOKING_SERVICE_URL=http://localhost:8083
MOCK_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=


# ---- Payments (later phases) ----
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Google Meet (later phases) ----
MEETING_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI (later phases) ----
AI_PROVIDER=mock
OPENAI_API_KEY=

