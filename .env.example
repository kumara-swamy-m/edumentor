# ---------- Required for docker compose ----------
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
DB_PASSWORD=change-me
PG_PASSWORD=change-me
ADMIN_EMAIL=admin@edumentor.local
ADMIN_PASSWORD=ChangeMe123

# ---------- Optional ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173
HOLD_DURATION=PT10M

# Payments: mock (default) or stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI: run with SPRING_PROFILES_ACTIVE=dev,openai and OPENAI_API_KEY to use OpenAI
OPENAI_API_KEY=

# Meetings: mock (default) or google
MEETING_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=